# Copy to `.env` and fill in from your Supabase project:
#   Dashboard -> Project Settings -> Data API  (URL)
#   Dashboard -> Project Settings -> API Keys  (the publishable / anon key)
#
# Both are safe to ship in a browser bundle — they are public by design, and
# row-level security in supabase/schema.sql is what actually protects the data.
# The `service_role` / secret key must NEVER go in here.
#
# With these unset the app runs against a localStorage backend instead, so you
# can work on screens and the game without a network round trip. The splash
# screen says which backend is live.

VITE_SUPABASE_URL=https://bmdmesfmkyaauyhgycsh.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=sb_publishable_8VfyigkQ3eFr1HpZ8uLZzw_QFiHgIL6
